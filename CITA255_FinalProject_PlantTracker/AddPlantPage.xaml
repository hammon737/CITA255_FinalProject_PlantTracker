<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local ="clr-namespace:CITA255_FinalProject_PlantTracker"
             x:Class="CITA255_FinalProject_PlantTracker.AddPlantPage"
             Title="AddPlantPage">
    
    <ScrollView>

        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="2.5*,*,*"
            Padding="24"
            RowSpacing="14"
            ColumnSpacing="9">

            <Label Grid.Row="0" Grid.Column="0"
                   Text="Add a Plant!"
                   FontSize="30"
                   FontAttributes="Bold" 
                   HorizontalTextAlignment="Center"/>
            <Label Grid.Row="1" Grid.Column="0"
                   Text="What's your plant's name?"
                   FontSize="18"
                   HorizontalTextAlignment="Start"
                   VerticalTextAlignment="End"/>
            <Entry Grid.Row="2" Grid.Column="0"
                   x:Name="PlantName"
                   Text=""
                   Placeholder="Plant Name"
                   FontSize="18" />
            <Label Grid.Row="3" Grid.Column="0"
                   Text="What type of plant is it?"
                   FontSize="18"
                   HorizontalTextAlignment="Start"
                   VerticalTextAlignment="End"/>
            <Entry Grid.Row="4" Grid.Column="0"
                   x:Name="PlantType"
                   Text=""
                   Placeholder="Plant Type"
                   FontSize="18" />
            <Label Grid.Row="5" Grid.Column="0"
                   Text="When do you have to water it?"
                   FontSize="18"
                   HorizontalTextAlignment="Start"
                   VerticalTextAlignment="End"/>
            <Entry Grid.Row="6" Grid.Column="0"
                   x:Name="WaterTime"
                   Text=""
                   Placeholder="Water Time"
                   FontSize="18" />
            <Label Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                   Text="Select your plant avatar:" 
                   HorizontalTextAlignment="Center"/>
            <Image x:Name="AvatarPic" 
                   Source ="cactihappy.png" 
                   Grid.Row="1" 
                   Grid.RowSpan="4" Grid.Column ="1" 
                   Grid.ColumnSpan="2" 
                   HeightRequest="220"/>
            <Button Grid.Row="5" Grid.Column="1" 
                    x:Name="Cactus" Text="Cactus" 
                    Clicked="CPlant"/>
            <Button Grid.Row="5" Grid.Column="2" 
                    x:Name="Flower" Text="Flower"
                     Clicked="FlPlant"/>
            <Button Grid.Row="6" Grid.Column="1" 
                    x:Name="Fern" Text="Fern"
                     Clicked="FePlant"/>
            <Button Grid.Row="6" Grid.Column="2" 
                    x:Name="Palm" Text="Palm"
                     Clicked="PPlant"/>
            <Button Grid.Row="8" Grid.ColumnSpan="3"
                   Text="Add your plant"
                   Clicked="OnAddClicked" />
            <Label Grid.Row="9" Grid.ColumnSpan="3"
                    Text="" 
                    HorizontalTextAlignment="Center" 
                    x:Name="resultLabel"/>
            <Border Grid.Row="10" Stroke="LightGray" StrokeThickness="1" Padding="4">

                <CollectionView x:Name="PlantView" 
                        ItemsSource="{Binding Plants}" 
                        SelectionMode="Single"
                        SelectionChanged="OnPlantSelected"
                        ItemsUpdatingScrollMode="KeepLastItemInView">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <local:ListSetup/>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <Label Text="No plants yet."
                               FontSize="16" TextColor="Gray"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </CollectionView.EmptyView>

                </CollectionView>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>