<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CITA255_FinalProject_PlantTracker.testPage"
             Title="testPage">
    <VerticalStackLayout>

        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
        Padding="24"
        RowSpacing="14">

            <Label Grid.Row="0"
               Text="Add a Plant!"
               FontSize="30"
               FontAttributes="Bold" />
            <Entry Grid.Row="3"
               x:Name="PlantName"
               Text=""
               Placeholder="Plant Name"
               FontSize="18" />
            <Entry Grid.Row="4"
               x:Name="PlantType"
               Text=""
               Placeholder="Plant Type"
               FontSize="18" />
            <Entry Grid.Row="5"
               x:Name="WaterTime"
               Text=""
               Placeholder="Water Time"
               FontSize="18" />
            <Button Grid.Row="6"
               Text="Add your plant"
               Clicked="OnAddClicked" />
        </Grid>
    </VerticalStackLayout>
</ContentPage>