<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CITA255_FinalProject_PlantTracker.ListSetup">
    <VerticalStackLayout>
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto"
              Padding="40,4">
            <Label Text="{Binding PlantNames}" Grid.Column="0"
                   FontSize="20"/>
            <Label Text="{Binding PlantTypes}" Grid.Row="1"/>
            <Label Text="{Binding WateringTimes}" Grid.Column="1" Grid.RowSpan="2"
                   FontSize="15"
                   VerticalTextAlignment="Center"/>
        </Grid>
    </VerticalStackLayout>
</ContentView>
