<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CITA255_FinalProject_PlantTracker.NewPage1">
    <VerticalStackLayout>
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
            <Label Text="{Binding PlantNames}" FontAttributes="Bold" Grid.Column="0"/>
            <Label Text="{Binding PlantTypes}" FontSize="12" TextColor="Gray" Grid.Row="1"/>
            <Label Text="{Binding WateringTimes}" Grid.Column="1"/>
        </Grid>
    </VerticalStackLayout>
</ContentPage>