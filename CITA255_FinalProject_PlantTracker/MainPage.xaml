<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CITA255_FinalProject_PlantTracker.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Grid RowDefinitions="Auto,Auto,Auto" 
                  ColumnDefinitions="*,Auto,*" 
                  RowSpacing="14"
                  ColumnSpacing="9">
                <Label Grid.Row="0" Grid.ColumnSpan="3"
                        Text="Welcome to Plant Tracker"
                        FontSize="20"
                        VerticalOptions="Center" 
                        HorizontalOptions="Center" />
                <Image Source ="cactihappy.png" Grid.Row="1" Grid.Column ="0"  
                       HeightRequest="300"
                       HorizontalOptions="End"/>
                <Image Source ="flowerhappy.png" Grid.Row="1" Grid.Column ="2"  
                       HeightRequest="300"
                       HorizontalOptions="Start"/>
                <Button Grid.Row="2" Grid.Column="1"
                        Text="Add a Plant"
                        VerticalOptions="Center"
                        Clicked="AddPlant"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
