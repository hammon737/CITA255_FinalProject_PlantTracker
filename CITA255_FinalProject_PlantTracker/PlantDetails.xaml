<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CITA255_FinalProject_PlantTracker.PlantDetails"
             Title="PlantDetails">
    <VerticalStackLayout>
        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
            <Label Grid.Row="0" Grid.Column="0"
                   Text="Did you water?"
                   x:Name="Name"
                   FontSize="20"
                   VerticalOptions="Center" 
                   HorizontalOptions="Start" />
            <Image x:Name="Pic" Source =" " Grid.Row="1" Grid.Column ="1"  HeightRequest="300"/>
            <Button Grid.Row="2" Grid.Column="0"
                   Text="Yes"
                   Clicked="Success"/>
            <Button Grid.Row="2" Grid.Column="2"
                   Text="No"
                   Clicked="Loss"/>
            <Label x:Name="Points" Grid.Row="3"
                   Text=""
                   FontSize="20"
                   VerticalOptions="Center" 
                   HorizontalOptions="Start" />
        </Grid>
    </VerticalStackLayout>
</ContentPage>